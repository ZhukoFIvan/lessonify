NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tutorflow

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=lessonify_bot
TELEGRAM_WEBHOOK_URL=

# URL веб-приложения для кнопки меню бота (требуется HTTPS для WebApp-кнопки)
WEB_APP_URL=https://app.lessonify.ru

# Gemini — распознавание голосовой диктовки уроков
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@tutorflow.app

# Платёжный сервис Robokassa
ROBOKASSA_LOGIN=your-merchant-login
ROBOKASSA_PASS1=your-password-1
ROBOKASSA_PASS2=your-password-2
ROBOKASSA_TEST=0
